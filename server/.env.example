# ============================================================
# HOTEL MANAGEMENT SYSTEM — ENVIRONMENT VARIABLES TEMPLATE
# ============================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit the .env file to version control.
# ============================================================

# --- Server ---
PORT=5000
NODE_ENV=development        # development | production

# --- MongoDB ---
# LOCAL DEVELOPMENT (MongoDB Community Server):
#   Install from https://www.mongodb.com/try/download/community
#   Start with:  mongod  (default port 27017)
#   No username/password needed for a default local install.
MONGODB_URI=mongodb://127.0.0.1:27017/hotel_management

# PRODUCTION (MongoDB Atlas):
#   Replace the line above with your Atlas connection string:
#   MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/hotel_management?retryWrites=true&w=majority
#
# IMPORTANT — Transactions & Replica Sets:
#   MongoDB transactions (used for booking conflict prevention) require a Replica Set.
#   - MongoDB Atlas: Replica Set is enabled automatically on all tiers. No extra setup.
#   - Local MongoDB Community Server: By default it runs as a standalone instance
#     and does NOT support transactions. Two options:
#       Option A (easiest): Use a standalone connection for development — transactions
#                           are disabled and booking conflict is checked without them.
#                           Set ENABLE_TRANSACTIONS=false in your .env.
#       Option B (full):    Run a local single-node Replica Set:
#                           1. mongod --replSet rs0 --dbpath ./data/db
#                           2. In mongosh: rs.initiate()
#                           3. Set ENABLE_TRANSACTIONS=true in your .env.
ENABLE_TRANSACTIONS=false

# --- JWT (JSON Web Tokens) ---
# Use a long random string — you can generate one with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_very_long_random_jwt_secret_here
JWT_EXPIRES_IN=24h

# Refresh tokens are stored in httpOnly cookies
JWT_REFRESH_SECRET=your_very_long_random_refresh_secret_here
JWT_REFRESH_EXPIRES_IN=7d

# --- Cloudinary (Image Uploads) ---
# Sign up at cloudinary.com and find these in your dashboard
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# --- Email (SMTP) ---
# Development: leave these blank to auto-use Ethereal (fake email, no real sending)
# Production: fill in your SMTP provider credentials
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM="Grand Horizon Hotel <noreply@grandhorizon.example>"

# --- Hotel Settings (these seed the database on first run) ---
HOTEL_NAME="Grand Horizon Hotel"
HOTEL_CURRENCY=ETB

# --- CORS ---
# Comma-separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:5173
